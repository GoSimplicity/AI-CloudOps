# 本地开发模板：复制为 .env 后填写；所有密钥类变量留空，禁止提交真实值。
# 发布栈（deploy/release/compose.yaml）请使用 deploy/release/env.example。
# 必填：JWT_KEY1、JWT_KEY2、MYSQL_ADDR、TREE_PASSWORD_ENCRYPTION_KEY（webhook 进程另需 WEBHOOK_MYSQL_ADDR；使用根目录 docker-compose.yaml 另需 REDIS_PASSWORD）；条件必填/可选见各项注释。
# 环境配置
ENV=development

# ============================================================================
# 应用主配置
# ============================================================================

# 服务器配置
SERVER_PORT=8889

# 日志配置
LOG_DIR=./logs
LOG_LEVEL=debug

# JWT配置（JWT_KEY1、JWT_KEY2 必填；production 要求 ≥32 字符、互不相同）
# 生成: openssl rand -hex 24
JWT_KEY1=
JWT_KEY2=
# 可选，用来覆盖 config yaml 里的 JWT_ISSUER，一般不要设：设了会覆盖 yaml 中的值，现有 token 将全部失效。
# JWT_ISSUER=
# JWT_EXPIRATION：访问令牌有效期，单位是分钟（pkg/jwt 按 time.Minute 计算），30 = 30 分钟；请勿按秒填写。
#   与发布模板 deploy/release/compose.yaml 一致。旧示例值 3600 实为 3600 分钟（60 小时）。
#   本分支（合入 sched/w1-mantou 前）：不设时取 config/*.yaml 的 jwt.expiration（现为 3600），≤0 时回退 30。
#   合入 sched/w1-mantou 后：代码与 config/*.yaml 默认 30；超过 1440（24 小时）时 ENV=production 拒绝启动，
#     其他环境告警后继续；≤0 时告警并使用 30。
JWT_EXPIRATION=30

# Redis配置（同时供根目录 docker-compose.yaml 的 redis --requirepass 使用）
REDIS_ADDR=localhost:6379
# 使用根目录 docker-compose.yaml 时必填：redis 以 --requirepass 启动，compose 用 ${REDIS_PASSWORD:?} 校验，留空会直接报错（生成: openssl rand -hex 24）
# 后端读取同一变量连接 Redis；不用 compose、连接无认证的 Redis 时才可留空。此处保持为空，不要提交真实值
REDIS_PASSWORD=

# MySQL配置
# 根目录 docker-compose.yaml 的 mysql root 口令（必填，生成: openssl rand -hex 24）
MYSQL_ROOT_PASSWORD=
# 必填。格式: <user>:<password>@tcp(localhost:3306)/cloudops?charset=utf8mb4&parseTime=True&loc=Local（勿提交真实口令）
MYSQL_ADDR=

# 树形结构配置
TREE_CHECK_STATUS_CRON=@every 300s
# 必填，必须恰好 32 字节（AES-256），生成: openssl rand -hex 16；升级时保持不变并与数据库一同备份
TREE_PASSWORD_ENCRYPTION_KEY=

# Kubernetes配置
K8S_REFRESH_CRON=@every 300s

# Prometheus配置
PROMETHEUS_REFRESH_CRON=@every 15s
PROMETHEUS_ENABLE_ALERT=0
PROMETHEUS_ENABLE_RECORD=0
# 告警推送地址：指向 webhook 进程（cmd/webhook）的 /api/v1/alerts/receive，不是主后端；端口须与 webhook 实际监听端口一致
# （默认 8889，见下方 WEBHOOK_PORT 说明）。
PROMETHEUS_ALERT_WEBHOOK_ADDR=http://localhost:8889/api/v1/alerts/receive
PROMETHEUS_ALERT_WEBHOOK_FILE_DIR=/tmp/webhook_files
# 指向后端自身的 HTTP SD 接口，端口与 SERVER_PORT（8889）一致
PROMETHEUS_HTTP_SD_API=http://localhost:8889/api/not_auth/getTreeNodeBindIps

# Mock配置
MOCK_ENABLED=true

# 定时任务配置（可选）
# CRON_ALLOW_LOCAL_EXEC 默认 false：命令行(2)/脚本(4)类定时任务不在后端主机本地执行，已有的这两类任务会停止执行。
# 设为 true 可保留这两类任务；scripts/integration/cron_crash_smoke.py 也要求 true。
# CRON_ALLOW_LOCAL_EXEC=

# ============================================================================
# 通知配置
# ============================================================================

# 邮箱通知配置
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_EMAIL_SMTP_HOST=smtp.qq.com
NOTIFICATION_EMAIL_SMTP_PORT=587
# 条件必填：NOTIFICATION_EMAIL_ENABLED=true 时需要 USERNAME/PASSWORD
NOTIFICATION_EMAIL_USERNAME=
NOTIFICATION_EMAIL_PASSWORD=
NOTIFICATION_EMAIL_FROM_NAME=AI-CloudOps
NOTIFICATION_EMAIL_MAX_RETRIES=3
NOTIFICATION_EMAIL_RETRY_INTERVAL=5m
NOTIFICATION_EMAIL_TIMEOUT=30s
NOTIFICATION_EMAIL_USE_TLS=true

# 飞书通知配置
NOTIFICATION_FEISHU_ENABLED=true
# 条件必填：NOTIFICATION_FEISHU_ENABLED=true 时需要 APP_ID/APP_SECRET
NOTIFICATION_FEISHU_APP_ID=
NOTIFICATION_FEISHU_APP_SECRET=
NOTIFICATION_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/
NOTIFICATION_FEISHU_PRIVATE_MESSAGE_API=https://open.feishu.cn/open-apis/im/v1/messages
NOTIFICATION_FEISHU_TENANT_ACCESS_TOKEN_API=https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal
NOTIFICATION_FEISHU_MAX_RETRIES=3
NOTIFICATION_FEISHU_RETRY_INTERVAL=5m
NOTIFICATION_FEISHU_TIMEOUT=10s

# ============================================================================
# Webhook子系统配置
# ============================================================================

# Webhook基础配置
# WEBHOOK_MYSQL_ADDR：webhook 进程（cmd/webhook）的完整 MySQL DSN，格式同 MYSQL_ADDR。
#   本分支（合入 sched/w1-mantou 前）：webhook 不读此变量，用 config/webhook.yaml 的 mysql.addr
#     （按代码：viper.AutomaticEnv 下同名环境变量 MYSQL_ADDR 会覆盖它）。
#   合入 sched/w1-mantou 后：必填、无默认值；webhook 不再读配置文件的 mysql.addr，也不用 MYSQL_ADDR。
# 发布栈：本分支的 deploy/release/compose.yaml 还没有 webhook 服务，单独部署 webhook 时自行注入；REL-03A（sched/rel03a-shaomai）
#   合入后由 compose 的 webhook 服务注入（release-env.py 生成）。REL-03A 必须与 w1（sched/w1-mantou）同时或在其之后合入，
#   否则镜像内的 webhook 不读此变量、仍用镜像内 config/webhook.yaml 的 mysql.addr（rel03a ca92816 实测）。
WEBHOOK_MYSQL_ADDR=
# WEBHOOK_PORT：webhook（cmd/webhook）监听端口，留空即用默认 8889。
#   本分支（合入 sched/w1-mantou 前）：WEBHOOK_PORT 不生效（实测设 12345 仍监听 webhook.port）。端口取自
#     config/webhook.yaml 的 webhook.port（现为 8889），没有配置文件时为代码默认 8888；要改端口只能修改
#     config/webhook.yaml，或用 --config 指向一份改了端口的配置副本。
#     副本必须保留 `webhook:` 根节点（port 写在 webhook.port 下）：没有根节点的平铺写法在本分支会被静默忽略，
#     端口回落到代码默认 8888；合入 w1-mantou 9d46160 后，平铺写法会在加载配置时直接拒绝启动（review3d 实测）。
#   合入 sched/w1-mantou 后（含其 bb410eb 修复）：优先级 WEBHOOK_PORT > 配置文件 > 默认 8889，空串视为未设置；
#     必须是 1-65535 的纯数字，否则 webhook 启动失败（以 bb410eb 实测：设 12345 即监听 12345）。
# 主后端（SERVER_PORT）默认同为 8889：分开的容器互不冲突，同一台机器同时跑两者会冲突，要把 webhook 错开：
#   合入前改 config/webhook.yaml 或用 --config；合入后显式设置 WEBHOOK_PORT（例如 8890）。
#   错开后同步修改上面的 PROMETHEUS_ALERT_WEBHOOK_ADDR。
# 发布栈（REL-03A 合入后）compose 不向 webhook 传 WEBHOOK_PORT，webhook 在自己的容器里监听镜像内配置的 8889，
#   合入 w1 前后一样，与 deploy/release/alertmanager.yml 的 webhook:8889 一致；这里的 WEBHOOK_PORT 只影响本机直接运行的 webhook。
WEBHOOK_PORT=
WEBHOOK_FIXED_WORKERS=10
WEBHOOK_FRONT_DOMAIN=http://localhost:3000
WEBHOOK_BACKEND_DOMAIN=http://localhost:8889
WEBHOOK_DEFAULT_UPGRADE_MINUTES=60
WEBHOOK_ALERT_MANAGER_API=http://localhost:9093
WEBHOOK_COMMON_MAP_RENEW_INTERVAL_SECONDS=300

# Webhook飞书配置
WEBHOOK_IM_FEISHU_GROUP_MESSAGE_API=https://open.feishu.cn/open-apis/im/v1/messages
WEBHOOK_IM_FEISHU_REQUEST_TIMEOUT_SECONDS=10
WEBHOOK_IM_FEISHU_PRIVATE_ROBOT_APP_ID=
WEBHOOK_IM_FEISHU_PRIVATE_ROBOT_APP_SECRET=
WEBHOOK_IM_FEISHU_TENANT_ACCESS_TOKEN_API=https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal

# ============================================================================
# 外部服务配置 (仅支持环境变量)
# ============================================================================

# 阿里云配置
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# LLM配置
LLM_API_KEY=
LLM_BASE_URL=https://xxx/v1

# 飞书Webhook
# 形如 https://open.feishu.cn/open-apis/bot/v2/hook/<token>，token 属于凭据
FEISHU_WEBHOOK=

# Tavily搜索配置
TAVILY_API_KEY=

# AI service gateway (same key as Python service; never expose to the browser)
AIOPS_BASE_URL=http://cloudops-aiops:8080
# 条件必填：production 下配置了 AIOPS_BASE_URL 时需要，≥32 字符
AIOPS_API_KEY=
# Exact browser origins, comma-separated. Empty allows same-origin requests only.
SERVER_ALLOWED_ORIGINS=http://localhost:5666
# Set only for the first empty-database boot, then remove. Minimum 12 characters.
BOOTSTRAP_ADMIN_PASSWORD=
