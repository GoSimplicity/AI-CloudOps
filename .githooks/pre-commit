#!/bin/bash

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 错误处理函数
function error_exit() {
    echo -e "${RED}[PRE-COMMIT ERROR]${NC} $1"
    exit 1
}

# 成功信息函数
function success_msg() {
    echo -e "${GREEN}[PRE-COMMIT]${NC} $1"
}

# 警告信息函数
function warning_msg() {
    echo -e "${YELLOW}[PRE-COMMIT]${NC} $1"
}

# 信息函数
function info_msg() {
    echo -e "${BLUE}[PRE-COMMIT]${NC} $1"
}

# 检查当前分支
BRANCH=$(git symbolic-ref --short HEAD)
info_msg "当前分支: $BRANCH"

# 显示环境变量提示
if [ -n "$SKIP_GENERATE" ] || [ -n "$SKIP_VET" ] || [ -n "$SKIP_BUILD" ]; then
    warning_msg "检测到跳过选项："
    [ "$SKIP_GENERATE" = "1" ] && echo "  - SKIP_GENERATE=1 (跳过 go generate)"
    [ "$SKIP_VET" = "1" ] && echo "  - SKIP_VET=1 (跳过 go vet)"
    [ "$SKIP_BUILD" = "1" ] && echo "  - SKIP_BUILD=1 (跳过编译检查)"
fi

# ---------------------------------------------------------------------------
# gitleaks: block commits that stage secrets (SEC-01A)
# ---------------------------------------------------------------------------
# gitleaks 最低版本 8.25.0（review3g N6）：.gitleaks.toml 使用多个 [[allowlists]]（含 targetRules/condition），
# 该写法自 8.25.0 起才支持；更低版本的策略语义不同，且 8.19 之前没有 `gitleaks git --staged`。
# 只接受 gitleaks version 输出的严格形式 X.Y.Z（可带前缀 v），无法解析一律视为不满足。
GITLEAKS_MIN_MAJOR=8
GITLEAKS_MIN_MINOR=25
gitleaks_version_check() {
    gl_ver_raw="$(gitleaks version 2>/dev/null | head -n 1)"
    gl_ver="${gl_ver_raw#v}"
    case "$gl_ver" in
        ''|*[!0-9.]*|.*|*.|*..*) return 2 ;;
    esac
    gl_major="${gl_ver%%.*}"; gl_rest="${gl_ver#*.}"
    gl_minor="${gl_rest%%.*}"; gl_patch="${gl_rest#*.}"
    case "$gl_rest" in *.*) ;; *) return 2 ;; esac
    case "$gl_patch" in ''|*.*) return 2 ;; esac
    if [ "$gl_major" -gt "$GITLEAKS_MIN_MAJOR" ]; then return 0; fi
    if [ "$gl_major" -eq "$GITLEAKS_MIN_MAJOR" ] && [ "$gl_minor" -ge "$GITLEAKS_MIN_MINOR" ]; then return 0; fi
    return 1
}
run_gitleaks_staged() {
    if ! command -v gitleaks >/dev/null 2>&1; then
        echo "[PRE-COMMIT ERROR] 未找到 gitleaks，已阻止提交。" >&2
        echo "  安装: https://github.com/gitleaks/gitleaks/releases (校验 sha256 后放入 PATH)" >&2
        echo "  然后执行: scripts/setup-git-hooks.sh" >&2
        exit 1
    fi
    gl_vrc=0; gitleaks_version_check || gl_vrc=$?
    if [ "$gl_vrc" -ne 0 ]; then
        if [ "$gl_vrc" -eq 2 ]; then
            echo "[PRE-COMMIT ERROR] 无法解析 gitleaks 版本（gitleaks version 输出: ${gl_ver_raw:-<空>}），需要 >= ${GITLEAKS_MIN_MAJOR}.${GITLEAKS_MIN_MINOR}.0，已阻止提交。" >&2
        else
            echo "[PRE-COMMIT ERROR] gitleaks 版本 ${gl_ver_raw} 低于 ${GITLEAKS_MIN_MAJOR}.${GITLEAKS_MIN_MINOR}.0，已阻止提交。" >&2
        fi
        echo "  请升级: https://github.com/gitleaks/gitleaks/releases (校验 sha256 后放入 PATH)" >&2
        exit 1
    fi
    local repo_root tmpd f
    repo_root="$(git rev-parse --show-toplevel)" || { echo "[PRE-COMMIT ERROR] 无法确定仓库根目录" >&2; exit 1; }
    # 策略文件只取暂存区（index）版本，与被扫描的暂存内容一致（review3g P3-1）。
    # gitleaks 默认读取工作区的 .gitleaks.toml，且总会自动读取“源目录/.gitleaksignore”（工作区文件）：
    # 未跟踪或有未暂存修改的放行配置/指纹会在提交时生效却不进入提交。因此这两个文件只要是未跟踪、
    # 或工作区与暂存区不一致（含工作区中删除），一律拒绝提交，请先暂存（git add）或还原（git restore）。
    for f in .gitleaks.toml .gitleaksignore; do
        if git -C "$repo_root" ls-files --error-unmatch -- "$f" >/dev/null 2>&1; then
            if ! git -C "$repo_root" diff --quiet -- "$f"; then
                echo "[PRE-COMMIT ERROR] $f 有未暂存的修改（或在工作区中被删除），gitleaks 策略只认暂存区版本，已阻止提交。" >&2
                echo "  请先 git add $f 或 git restore $f 后重新提交。" >&2
                exit 1
            fi
        elif [ -e "$repo_root/$f" ] || [ -L "$repo_root/$f" ]; then
            echo "[PRE-COMMIT ERROR] $f 未跟踪（不在暂存区），会被 gitleaks 读取却不进入提交，已阻止提交。" >&2
            echo "  请先 git add $f 或删除该文件后重新提交。" >&2
            exit 1
        fi
    done
    tmpd="$(mktemp -d "${TMPDIR:-/tmp}/gitleaks-hook.XXXXXX")" || { echo "[PRE-COMMIT ERROR] mktemp 失败" >&2; exit 1; }
    if git -C "$repo_root" cat-file -e ":.gitleaks.toml" 2>/dev/null; then
        git -C "$repo_root" show ":.gitleaks.toml" >"$tmpd/gitleaks.toml" || { rm -rf "$tmpd"; echo "[PRE-COMMIT ERROR] 无法读取暂存区的 .gitleaks.toml" >&2; exit 1; }
    else
        # 暂存区没有配置：显式使用默认规则（不受 GITLEAKS_CONFIG 等环境变量影响）
        printf '[extend]\nuseDefault = true\n' >"$tmpd/gitleaks.toml"
    fi
    if git -C "$repo_root" cat-file -e ":.gitleaksignore" 2>/dev/null; then
        git -C "$repo_root" show ":.gitleaksignore" >"$tmpd/gitleaksignore" || { rm -rf "$tmpd"; echo "[PRE-COMMIT ERROR] 无法读取暂存区的 .gitleaksignore" >&2; exit 1; }
    else
        : >"$tmpd/gitleaksignore"
    fi
    # 残余风险：暂存区配置中的 [extend] path 仍按当前目录读取工作区文件（CI 侧由 gitleaks-config-check.py 拒绝）。
    # --ignore-gitleaks-allow：源码里的 "gitleaks:allow" 行内注释不再豁免任何发现（任何人都能在密钥行后加这条注释）；
    #   误报只能在 .gitleaks.toml 中按值精确放行（SEC-01A 第三轮 P3-1）。
    # 已保证 >= 8.25.0，直接使用 `gitleaks git --staged`（不再回退到旧的 `gitleaks protect --staged`，review3g N6）。
    gitleaks git --pre-commit --staged --redact --no-banner --verbose --ignore-gitleaks-allow \
        --config "$tmpd/gitleaks.toml" --gitleaks-ignore-path "$tmpd/gitleaksignore" "$repo_root"
    local rc=$?
    rm -rf "$tmpd"
    if [ $rc -ne 0 ]; then
        echo "" >&2
        echo "[PRE-COMMIT ERROR] gitleaks 在暂存内容中发现疑似密钥（以上输出已脱敏），提交已被阻止。" >&2
        echo "  请移除密钥并改为环境变量/密钥管理；若确属误报，请在 .gitleaks.toml 中添加带注释的窄范围 allowlist。" >&2
        exit 1
    fi
    echo "[PRE-COMMIT] gitleaks: 暂存内容未发现密钥"
}
run_gitleaks_staged

# 记录 gitleaks 扫描时的暂存区快照。后续步骤不得修改暂存区（否则新暂存的内容未经扫描）。
INDEX_TREE_SCANNED="$(git write-tree)" || error_exit "无法读取暂存区（git write-tree 失败）"

# 检查是否有Go文件变更
if git diff --cached --quiet -- '*.go'; then
    warning_msg "未检测到 Go 文件变更，跳过Go相关检查"
    success_msg "提交准备就绪"
    exit 0
else
    info_msg "检测到 Go 文件变更，开始执行检查..."
fi

# 1. 执行 go generate
if [ "$SKIP_GENERATE" = "1" ]; then
    warning_msg "跳过 go generate (SKIP_GENERATE=1)"
else
    info_msg "步骤 1/4: 执行 go generate ./..."
    if ! go generate ./... 2>&1; then
        echo ""
        error_exit "go generate 执行失败！
        
可能的解决方案：
1. 检查 Wire 依赖注入配置是否正确
2. 确保所有必要的 provider 都已定义
3. 运行 'go mod tidy' 确保依赖完整
4. 如果是已知问题且不影响核心功能，可以临时跳过：
   SKIP_GENERATE=1 git commit -m '你的提交信息'

详细错误信息请查看上面的输出。"
    fi
    success_msg "go generate 执行成功"
fi

# 2. 代码格式检查（只检查，不修改、不暂存）
# 只检查“暂存的” .go 文件的“暂存版本”内容（git cat-file blob :path），与 gitleaks 扫描的内容一致。
# 旧实现在 gitleaks 之后执行 `go fmt ./...` 并 `git add`，会把工作区中未暂存的改动（甚至从未暂存过的
# .go 文件）连同其中未经扫描的密钥一起加入提交（SEC-01A 审查 G1/G2），已移除。
info_msg "步骤 2/4: 检查暂存的 Go 文件格式 (gofmt)..."
command -v gofmt >/dev/null 2>&1 || error_exit "未找到 gofmt，无法检查代码格式"
UNFORMATTED_FILES=()
while IFS= read -r -d '' file; do
    if [ -n "$(git cat-file blob ":$file" | gofmt -l 2>&1)" ]; then
        UNFORMATTED_FILES+=("$file")
    fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.go')
if [ ${#UNFORMATTED_FILES[@]} -gt 0 ]; then
    echo -e "${RED}[PRE-COMMIT ERROR]${NC} 以下暂存的 Go 文件未按 gofmt 格式化（检查的是暂存版本）:"
    printf '  %s\n' "${UNFORMATTED_FILES[@]}"
    echo "请自行格式化并重新暂存后再提交，例如:"
    echo "  gofmt -w <文件> && git add -p <文件>   # 注意只暂存你确认要提交的内容"
    exit 1
fi
success_msg "代码格式检查完成"

# 3. 静态分析检查 (go vet)
if [ "$SKIP_VET" = "1" ]; then
    warning_msg "跳过静态分析检查 (SKIP_VET=1)"
else
    info_msg "步骤 3/4: 执行静态分析 (go vet)..."
    if ! go vet ./...; then
        error_exit "go vet 检查发现问题，请修复后重新提交
        
如果这是已知的非关键问题，可以临时跳过：
SKIP_VET=1 git commit -m '你的提交信息'"
    fi
    success_msg "静态分析通过"
fi

# 4. 编译检查
if [ "$SKIP_BUILD" = "1" ]; then
    warning_msg "跳过编译检查 (SKIP_BUILD=1)"
else
    info_msg "步骤 4/4: 执行编译检查..."
    if ! go build ./...; then
        error_exit "代码编译失败，请修复编译错误后重新提交
        
如果这是已知的依赖问题，可以临时跳过：
SKIP_BUILD=1 git commit -m '你的提交信息'"
    fi

    success_msg "编译检查通过"
fi

# 检查是否有新的文件需要添加到暂存区（由于go generate可能生成新文件）
GENERATED_FILES=$(git ls-files --others --exclude-standard | grep '\.go$')
if [ -n "$GENERATED_FILES" ]; then
    warning_msg "发现新生成的Go文件:"
    echo "$GENERATED_FILES"
    warning_msg "请检查这些文件是否应该被提交，如需要请手动 git add"
fi

# 防御性检查：gitleaks 扫描之后暂存区不得被任何步骤修改（如 go generate 的副作用），否则拒绝提交。
if [ "$(git write-tree)" != "$INDEX_TREE_SCANNED" ]; then
    error_exit "gitleaks 扫描后暂存区发生了变化，新暂存的内容未经密钥扫描，已阻止提交。请检查后重新 git commit。"
fi

success_msg "所有检查通过，准备提交"
exit 0