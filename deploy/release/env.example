# AI-CloudOps 发布栈环境变量模板（deploy/release/compose.yaml 读取 deploy/release/.env）
# 用法：优先运行 python3 scripts/release-env.py 自动生成 .env（0600，不打印密钥），
#       或复制本文件为 deploy/release/.env 并逐项填写，然后 chmod 600 deploy/release/.env。
# 本文件只允许出现变量名和注释，所有值必须为空；禁止提交真实值（.env 已被 .gitignore 忽略）。
# 已与后端 W1 必需变量清单对账：后端必填 JWT_KEY1/JWT_KEY2/TREE_PASSWORD_ENCRYPTION_KEY 在下方；MYSQL_ADDR 由 compose 用 MYSQL_PASSWORD 拼接。
# JWT_ISSUER 由 compose 注入与 config yaml 一致的默认值（运行镜像不包含配置文件）。通常不要覆盖；修改它会使现有 token 全部失效。
# WEBHOOK_MYSQL_ADDR 供 compose 中的 webhook 服务（告警接收）使用，compose 为 :? 强制；CRON_ALLOW_LOCAL_EXEC 当前未接入发布栈 compose，写在 .env 中不会生效。
# 可选 Alertmanager 用 compose profile 启用：docker compose --profile alerting up -d（默认不启动，无需额外变量）。
# 运行环境 ENV 不在本文件设置：compose.yaml 已为 backend/aiops/mcp 显式写 ENV: production，后端镜像默认也是 production。
# 后端 ENV 可选值（大小写不敏感，首尾空白忽略）：production/prod/prd（生产）、development/dev（开发）。
# ENV 未设置、为空（含只有空白）或为其他取值（包括 test/testing）时后端拒绝启动（SEC-27）；APP_ENV 不生效。

# ---------- 数据库 / 缓存（必填，compose 中为 :? 强制）----------
# MySQL cloudops 业务账号口令（生成: openssl rand -hex 24；仅用 hex，避免 DSN 分隔符）
MYSQL_PASSWORD=
# MySQL root 口令（生成: openssl rand -hex 24）
MYSQL_ROOT_PASSWORD=
# Redis requirepass，backend/aiops/mcp 共用（生成: openssl rand -hex 24）
REDIS_PASSWORD=

# webhook 进程（cmd/webhook）的完整 MySQL DSN（含口令，必填）。release-env.py 用 MYSQL_PASSWORD 自动拼出：
#   cloudops:<MYSQL_PASSWORD>@tcp(mysql:3306)/cloudops?charset=utf8mb4&parseTime=True&loc=UTC
# 已有 .env 升级时运行 python3 scripts/release-env.py --add-missing 只追加此项，不改动其他值。webhook 不读取 backend 的 MYSQL_ADDR。
WEBHOOK_MYSQL_ADDR=

# Fresh 生成器将机器人凭据留空、三个 API 指向回环地址；已有部署需显式配置。
WEBHOOK_IM_FEISHU_PRIVATE_ROBOT_APP_ID=
WEBHOOK_IM_FEISHU_PRIVATE_ROBOT_APP_SECRET=
WEBHOOK_IM_FEISHU_TENANT_ACCESS_TOKEN_API=
WEBHOOK_IM_FEISHU_PRIVATE_MESSAGE_API=
WEBHOOK_IM_FEISHU_GROUP_MESSAGE_API=

# ---------- 后端鉴权与加密（必填）----------
# JWT 签名密钥 1/2（生成: openssl rand -hex 24）
JWT_KEY1=
JWT_KEY2=
# 主机密码 AES 加密密钥，必须恰好 32 字节（生成: openssl rand -hex 16）；升级时保持不变，并与数据库一同备份
TREE_PASSWORD_ENCRYPTION_KEY=
# 首次空库启动时的 admin 初始口令（至少 12 位）
BOOTSTRAP_ADMIN_PASSWORD=
# backend 与 aiops/mcp 之间的内部服务 API Key（生成: openssl rand -hex 24），勿暴露给浏览器
AIOPS_API_KEY=

# ---------- 访问入口 ----------
# 浏览器访问的精确 Origin（用作 SERVER_ALLOWED_ORIGINS），如 http://localhost:18080
PUBLIC_ORIGIN=
# gateway 对外端口（compose 默认 18080）
HTTP_PORT=
# gateway 绑定地址（compose 默认 127.0.0.1；仅在受控网络中改为 0.0.0.0）
BIND_ADDRESS=
# 镜像 tag（compose 默认 local）
RELEASE_VERSION=

# ---------- AIOps LLM（aiops 服务）----------
# LLM 服务 API Key（OpenAI 兼容接口）
LLM_API_KEY=
# OpenAI 兼容接口 base URL（compose 默认 https://api.siliconflow.cn/v1）
LLM_BASE_URL=
# 主对话模型（compose 默认 Qwen/Qwen2.5-32B-Instruct）
LLM_MODEL=
# 任务/工具调用模型（compose 默认 Qwen/Qwen2.5-14B-Instruct）
LLM_TASK_MODEL=
# 向量化模型（compose 默认 BAAI/bge-m3）
LLM_EMBEDDING_MODEL=
# RAG 使用的 OpenAI 兼容 embedding 模型（compose 默认 BAAI/bge-m3）
RAG_OPENAI_EMBEDDING_MODEL=

# ---------- 通知（aiops）----------
# 是否启用通知（compose 默认 true）
NOTIFICATION_ENABLED=
# 飞书自定义机器人 webhook（含 token，属凭据；可留空）
FEISHU_WEBHOOK_URL=

# ---------- 可选：构建/调优（不设置则使用 compose 默认值）----------
# GO_MODULE_PROXY=
# NPM_REGISTRY=
# PROMETHEUS_HTTP_SD_API=
# backend 告警推送地址，compose 默认 http://webhook:8889/api/v1/alerts/receive（Compose 内的 webhook 服务）；
# 仅当 Alertmanager 在 Compose 网络外时覆盖为它能访问的 webhook 地址（webhook 默认不发布端口，需自行暴露）；
# scheme 建议写小写 http:// 或 https://，不区分大小写（合入 w1 后 HTTP:// 也按完整 URL 处理；合入前的旧代码区分大小写），也可写 host:port
# PROMETHEUS_ALERT_WEBHOOK_ADDR=
# MYSQL_MAX_OPEN_CONNS=
# MYSQL_MAX_IDLE_CONNS=
# MYSQL_CONN_MAX_LIFETIME=
# MYSQL_CONN_MAX_IDLE_TIME=
# MYSQL_CONNECT_TIMEOUT=
# MYSQL_STARTUP_TIMEOUT=
# 仅在叠加 ssh.yaml 时必填：已核验的 known_hosts 文件路径
# SSH_KNOWN_HOSTS_FILE=
